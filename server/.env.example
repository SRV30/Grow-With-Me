PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional second frontend origin, e.g. https://www.your-domain.com
FRONTEND_WWW_URL=

MONGODB_URL=

JWT_SECRET=
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Default password used when creating a new admin user from the dashboard.
# Set this to the default password you want to use.
DEFAULT_USER_PASSWORD=

# Used by `npm run admin:create`
ADMIN_NAME=Grow With Me Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Growwithme
