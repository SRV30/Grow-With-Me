# Frontend (set in the Vercel client project)
VITE_SITE_URL=https://your-frontend-domain.vercel.app
VITE_BACKEND_URL=https://your-backend-domain.vercel.app/api

# Backend (set in the Vercel server project)
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.vercel.app

# MongoDB Atlas
MONGODB_URL=

# Authentication
JWT_SECRET=
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Growwithme
