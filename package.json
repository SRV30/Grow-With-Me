{
  "name": "grow-with-me",
  "private": true,
  "version": "0.1.0",
  "description": "Grow With Me full-stack application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --workspace grow-with-me-client run dev",
    "dev:server": "npm --workspace grow-with-me-server run dev",
    "build": "npm --workspace grow-with-me-client run build",
    "preview": "npm --workspace grow-with-me-client run preview",
    "start": "npm --workspace grow-with-me-server run start",
    "install:all": "npm install",
    "format": "npx prettier@latest --write .",
    "format:check": "npx prettier@latest --check .",
    "check": "npm run build"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
